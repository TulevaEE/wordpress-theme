#: templates/components/modal-question-rights.php:26
msgid ""
"\n"
"                        <ul>\n"
"                            <li>Comply with laws and follow the decisions made by Tuleva’s managerial board</li>\n"
"                            <li>Pay a one-time membership fee</li>\n"
"                            <li>Keep Tuleva’s business secrets</li>\n"
"                            <li>Pay additional fees if decided so by the general assembly*</li>\n"
"                        </ul>"
msgstr ""
"\n"
"                        <ul>\n"
"                            <li>täitma seadusi ning ühistu juhtimis- ja kontrollorganite seaduslikke ja ühistu põhikirjaga kooskõlas olevaid otsuseid</li>\n"
