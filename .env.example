# Copied to .env by setup.sh on first run. Edit .env, not this file.
# .env is gitignored — real hostnames, usernames and passwords live only there,
# never in this file (this repo is public).

# WordPress container image. Keep the PHP version matching production (8.5).
# Set the WordPress version to match production too — wp-admin shows it in the
# bottom-right corner. A newer container silently runs core upgrade routines
# against your local copy of the database on first admin load.
WP_IMAGE=wordpress:7.0.2-php8.5-apache

SITE_PORT=8880
SITE_URL=http://localhost:8880

# Local container database name. Arbitrary — the dump imports into whatever this
# is, so it need not match production.
DB_NAME=tuleva_wp
TABLE_PREFIX=wp_

# Local-only admin, created by wp-init. Not a production account.
ADMIN_USER=admin
ADMIN_PASS=admin
ADMIN_EMAIL=dev@example.test

# Missing local uploads (images, PDFs) are 302-redirected to the live site so
# the local copy looks right without bundling several GB of media.
UPLOADS_FALLBACK_URL=https://tuleva.ee/wp-content/uploads

# --- Building your local database + plugins ---------------------------------
# tools/export-prod-assets.sh reads these to pull the DB and plugins from
# production. Get the real values from the team 1Password vault and paste them
# below (use a read-only database account — the export only ever SELECTs).
# Never commit them; .env is gitignored.
# PROD_SSH=user@host
# PROD_WEBROOT=path/to/site/htdocs
# PROD_DB_HOST=your-db-host
# PROD_DB_NAME=your_db
# PROD_DB_USER=your_readonly_db_user
# PROD_DB_PASS=
