[mysqld]
sql_mode = "NO_ENGINE_SUBSTITUTION"

# A production WordPress dump carries multi-megabyte serialized rows in
# wp_options (icl_sitepress_settings) and wp_postmeta (ACF flexible content).
# The 64M default aborts the import partway through with "MySQL server has
# gone away", which looks like a container crash rather than a packet limit.
max_allowed_packet = 512M

innodb_buffer_pool_size = 512M
skip-log-bin
